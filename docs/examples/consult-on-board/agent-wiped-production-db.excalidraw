    {
      "id": "l0PhOqg82mj8Lp-IdImV-",
      "type": "text",
      "x": 814,
      "y": 2110,
      "width": 394.7997741699219,
      "height": 825,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1eZ",
      "roundness": null,
      "seed": 1164898696,
      "version": 3,
      "versionNonce": 1151828104,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794244245393,
      "link": null,
      "locked": false,
      "customData": {
        "grwbKind": "answer"
      },
      "text": "My view: bring in the ops lead now,\nand send before 6. Your call and hers.\n\nThe app is down, so clinics already\nknow something is wrong. And you don't\nhave to say \"we lost it\". You don't\nknow that yet. \"May be incomplete\"\nis the true version today.\n\nDraft, change anything:\n\"Our system is down after a database\nproblem today. We are restoring it now.\nRecords from today may be incomplete.\nPlease keep paper notes of today's\nvisits, payments and new bookings.\nWe will update you by [time].\"\n\nKeep the cause out of it for now.\nText your founder the exact words\nbefore you send, so she lands to them.\nShe may still be upset. A careful note\nthe ops lead OK'd is far easier to\nstand behind than clinics closing\nwith no word from you.\n\nJonah: phone the 3 Saturday clinics\nbefore 6. Say you will contact them\ntonight about their appointment list.\nThe restored copy should have bookings\nup to 03:10. Don't promise more yet.\n\nI added your news to the columns.\nTell me what the ops lead says.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "My view: bring in the ops lead now,\nand send before 6. Your call and hers.\n\nThe app is down, so clinics already\nknow something is wrong. And you don't\nhave to say \"we lost it\". You don't\nknow that yet. \"May be incomplete\"\nis the true version today.\n\nDraft, change anything:\n\"Our system is down after a database\nproblem today. We are restoring it now.\nRecords from today may be incomplete.\nPlease keep paper notes of today's\nvisits, payments and new bookings.\nWe will update you by [time].\"\n\nKeep the cause out of it for now.\nText your founder the exact words\nbefore you send, so she lands to them.\nShe may still be upset. A careful note\nthe ops lead OK'd is far easier to\nstand behind than clinics closing\nwith no word from you.\n\nJonah: phone the 3 Saturday clinics\nbefore 6. Say you will contact them\ntonight about their appointment list.\nThe restored copy should have bookings\nup to 03:10. Don't promise more yet.\n\nI added your news to the columns.\nTell me what the ops lead says.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BtiT3n9PtcIM6FOHcs4t1",
      "type": "text",
      "x": 813.8998870849609,
      "y": 3017.5,
      "width": 2263.278564453125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1ea",
      "roundness": null,
      "seed": 200683400,
      "version": 3,
      "versionNonce": 1434423032,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794244269182,
      "link": null,
      "locked": false,
      "text": "ops lead said ok, she changed one line, we sent it 17:58. texted founder the exact words. Jonah got 2 of the 3 sat clinics, 3rd is voicemail\nrestore at 55%\nI still feel like everything is 10 things at once. a guy I used to work with kept going on about the \"Issue-Driven Framework\", no idea what that is or how it works. can you sort this whole mess with that? or is that dumb right now",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ops lead said ok, she changed one line, we sent it 17:58. texted founder the exact words. Jonah got 2 of the 3 sat clinics, 3rd is voicemail\nrestore at 55%\nI still feel like everything is 10 things at once. a guy I used to work with kept going on about the \"Issue-Driven Framework\", no idea what that is or how it works. can you sort this whole mess with that? or is that dumb right now",
      "autoResize": true,
      "lineHeight": 1.25
    },
