    {
      "id": "-6ZeKaeKFm_Jwf8EoQmuw",
      "type": "text",
      "x": 4124.670021057129,
      "y": 465.5,
      "width": 77.65995788574219,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1gM",
