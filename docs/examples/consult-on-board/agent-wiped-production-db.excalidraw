    {
      "id": "WdQ20XJaK0Z6EdMJ-7UEF",
      "type": "text",
      "x": 8722.300109863281,
      "y": 817.5,
      "width": 375.3997802734375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
