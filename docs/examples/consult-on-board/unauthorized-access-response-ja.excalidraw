    {
      "id": "G0WedgUGhsHvxg-WgdQN4",
      "type": "text",
      "x": 880,
      "y": 960,
      "width": 460,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
