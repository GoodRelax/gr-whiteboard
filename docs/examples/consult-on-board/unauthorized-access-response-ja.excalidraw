    {
      "id": "BhEWlUzP4IpU8psdm9KQI",
      "type": "rectangle",
      "x": 3240,
      "y": 480,
      "width": 260,
      "height": 155,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
