    {
      "id": "id-ans-1",
      "type": "text",
      "x": 20,
      "y": 2948,
      "width": 571.239990234375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
