      "locked": false,
      "customData": {
        "grwbKind": "claudeItem"
      },
      "text": "この対応は何のため？「〜する」の形で",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "この対応は何のため？「〜する」の形で",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8cw4_5EYxakRVUXZukpYq",
      "type": "text",
      "x": 760,
      "y": 720,
      "width": 460,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
