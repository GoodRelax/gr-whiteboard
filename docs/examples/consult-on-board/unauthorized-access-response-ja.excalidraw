      "locked": false,
      "customData": {
        "grwbKind": "claudeItem"
      },
      "text": "事実を「分かっている」と「分かっていない」に分ける",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "事実を「分かっている」と「分かっていない」に分ける",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "id-an-l1",
