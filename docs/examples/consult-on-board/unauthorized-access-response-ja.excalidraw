      "boundElements": [],
      "updated": 1793732237109,
      "link": null,
      "locked": false,
      "text": "取引先にお金の被害を出さないようにする。\nそれと、取引先に「サンプル製作所のメールは大丈夫」と\nまた信じてもらえるようにしたいです。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "取引先にお金の被害を出さないようにする。\nそれと、取引先に「サンプル製作所のメールは大丈夫」と\nまた信じてもらえるようにしたいです。",
      "autoResize": true,
      "lineHeight": 1.25
    },
