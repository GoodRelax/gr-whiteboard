    {
      "id": "hcGcWdGC28zwrdw6Rans4",
      "type": "text",
      "x": 3977.5,
      "y": 501.875,
      "width": 325,
      "height": 146.25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0BL",
      "roundness": null,
      "seed": 558545838,
      "version": 14,
      "versionNonce": 780875442,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793733827784,
      "link": null,
      "locked": false,
      "customData": {
        "grwbKind": "claudeItem"
      },
      "text": "対策1\n社長が「情報セキュリティの担当」を正式に決め、\n担当が二段階認証・パスワード・\nサインイン記録（異常の通知を含む）の\n決まりを作って半年ごとに点検し、\nパスワード管理の道具を入れ、\n年1回30分、全員に使い回しをしないことと\n変なメールの見分け方を説明し、\n業者に任せる範囲（保護サービス契約を含む）を決める",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "w5-m1",
      "originalText": "対策1\n社長が「情報セキュリティの担当」を正式に決め、\n担当が二段階認証・パスワード・\nサインイン記録（異常の通知を含む）の\n決まりを作って半年ごとに点検し、\nパスワード管理の道具を入れ、\n年1回30分、全員に使い回しをしないことと\n変なメールの見分け方を説明し、\n業者に任せる範囲（保護サービス契約を含む）を決める",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7itizlUvmIyLnSJmCmCT3",
      "type": "text",
      "x": 3988,
      "y": 702.5,
      "width": 304,
      "height": 80,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0CUzyK",
      "roundness": null,
      "seed": 605230574,
      "version": 12,
      "versionNonce": 1883085810,
      "isDeleted": false,
      "boundElements": [],
