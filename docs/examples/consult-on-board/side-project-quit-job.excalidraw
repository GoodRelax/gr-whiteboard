    },
    {
      "id": "KScMES0uf98niCQLaEoH-",
      "type": "text",
      "x": 1500,
      "y": 1340,
      "width": 410.8597412109375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1971c2",
