    {
      "id": "bP9MrWB1X4IFL5P0bV2_U",
      "type": "text",
      "x": 1500,
      "y": 1060,
      "width": 384.5397644042969,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
