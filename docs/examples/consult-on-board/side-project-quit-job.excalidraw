    {
      "id": "id-bg-1",
      "type": "text",
      "x": 0,
      "y": 250,
      "width": 431.7796325683594,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
