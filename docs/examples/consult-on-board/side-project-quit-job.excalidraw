      "index": "c23l",
      "roundness": null,
      "seed": 2023062439,
      "version": 3,
      "versionNonce": 757757961,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794547781686,
      "link": null,
      "locked": false,
      "text": "My scores:\nreorgs 4, guitar guy 3, what if 4\nmoney 4, Jess 3, kids 4, 1 customer 5\nThe gray ?: ugh. honestly reorgs push\nme toward ANY way out. a nicer job would\nfix that one. so maybe it's not really a\nTuneslot force?\nAnd \"1 customer\" is a 5 bc it's the one\nthat makes me feel dumb.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "My scores:\nreorgs 4, guitar guy 3, what if 4\nmoney 4, Jess 3, kids 4, 1 customer 5\nThe gray ?: ugh. honestly reorgs push\nme toward ANY way out. a nicer job would\nfix that one. so maybe it's not really a\nTuneslot force?\nAnd \"1 customer\" is a 5 bc it's the one\nthat makes me feel dumb.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
