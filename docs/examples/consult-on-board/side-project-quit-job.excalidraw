    {
      "id": "id-pu-1",
      "type": "text",
      "x": 0,
      "y": 610,
      "width": 323.27984619140625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
