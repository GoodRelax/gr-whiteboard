      "seed": 1453155655,
      "version": 3,
      "versionNonce": 829087849,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794547840268,
      "link": null,
      "locked": false,
      "text": "Yes, move reorgs to Notes. it's a job problem.\nHow many saw it... the post had like 60 views.\nSo maybe 60 teachers ever. and 1 paid.\nSo it's \"never heard of it\", not \"they said no\".\nhuh. that's kind of a relief and kind of worse.\nI've been treating 1 customer like a verdict\nwhen I never really asked anyone.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Yes, move reorgs to Notes. it's a job problem.\nHow many saw it... the post had like 60 views.\nSo maybe 60 teachers ever. and 1 paid.\nSo it's \"never heard of it\", not \"they said no\".\nhuh. that's kind of a relief and kind of worse.\nI've been treating 1 customer like a verdict\nwhen I never really asked anyone.",
      "autoResize": true,
      "lineHeight": 1.25
    },
