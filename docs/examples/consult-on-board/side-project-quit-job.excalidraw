      "link": null,
      "locked": false,
      "customData": {
        "grwbKind": "claudeItem"
      },
      "text": "Issue (sharpened):\n\"Will 25 paying teachers who aren't my\nmom sign up by end of April, once they\nhear about Tuneslot?\"\n- about 5 months of nights + weekends\n- 25 x $12 = $300/mo, tiny, but it would\n  prove people pay once they hear about it\n- I know me, I'd move the bar",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Issue (sharpened):\n\"Will 25 paying teachers who aren't my\nmom sign up by end of April, once they\nhear about Tuneslot?\"\n- about 5 months of nights + weekends\n- 25 x $12 = $300/mo, tiny, but it would\n  prove people pay once they hear about it\n- I know me, I'd move the bar",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e5yMFEnnGvEZu8ra-lsVW",
      "type": "text",
      "x": 1500,
      "y": 2829,
      "width": 390.65972900390625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
