      "link": null,
      "locked": false,
      "customData": {
        "grwbKind": "answer"
      },
      "text": "Your draft is under # Issue. It's a real\nquestion, and it's the right kind.\nNot cheating: that's the point. Answer\nthe question before the step you can't\ntake back.\nOne tweak to make it answerable soon:\n\"replace my salary\" may take years to\nfind out. What smaller sign would tell\nyou \"this works\"? How many paying\nteachers, by when?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Your draft is under # Issue. It's a real\nquestion, and it's the right kind.\nNot cheating: that's the point. Answer\nthe question before the step you can't\ntake back.\nOne tweak to make it answerable soon:\n\"replace my salary\" may take years to\nfind out. What smaller sign would tell\nyou \"this works\"? How many paying\nteachers, by when?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "D3XTY5tonPfr_HmfEowMI",
      "type": "text",
      "x": 1500.2331899007163,
      "y": 2616.666666666667,
      "width": 449.79986572265625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
