      "version": 3,
      "versionNonce": 1500068615,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794547810360,
      "link": null,
      "locked": false,
      "customData": {
        "grwbKind": "answer"
      },
      "text": "Scores in, sums added. Your notes are in\nNotes, right of the frame.\nToward: 11 (7 without reorgs)\nHolding back: 16\nShall I move \"reorgs\" to Notes? Your call.\nOn \"1 customer\": no need to feel dumb.\nA question about that one:\n1 forum post, zero selling. How many\nteachers do you think ever saw Tuneslot?\nIs it \"they said no\", or \"they never\nheard of it\"?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scores in, sums added. Your notes are in\nNotes, right of the frame.\nToward: 11 (7 without reorgs)\nHolding back: 16\nShall I move \"reorgs\" to Notes? Your call.\nOn \"1 customer\": no need to feel dumb.\nA question about that one:\n1 forum post, zero selling. How many\nteachers do you think ever saw Tuneslot?\nIs it \"they said no\", or \"they never\nheard of it\"?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qf28BULSrhv2JyoMMKQYk",
      "type": "text",
      "x": 1500.4298706054688,
      "y": 1680.8333333333335,
      "width": 449.7796936035156,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
