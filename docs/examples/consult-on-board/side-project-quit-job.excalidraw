      "version": 3,
      "versionNonce": 1418568839,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794547742811,
      "link": null,
      "locked": false,
      "customData": {
        "grwbKind": "answer"
      },
      "text": "I put your forces in the frame (right).\nHow to weigh: give each one a score,\n1 = barely matters, 5 = huge for you.\nGut feel is fine. Write the number in\nthe [ ? ]. I'll add up each side.\nOne thing to look at first (the gray ?):\n\"hate the reorgs\" pushes you OUT of\nBrightloom. Does it push you toward\nTuneslot, or toward any way out?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I put your forces in the frame (right).\nHow to weigh: give each one a score,\n1 = barely matters, 5 = huge for you.\nGut feel is fine. Write the number in\nthe [ ? ]. I'll add up each side.\nOne thing to look at first (the gray ?):\n\"hate the reorgs\" pushes you OUT of\nBrightloom. Does it push you toward\nTuneslot, or toward any way out?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DxMsRngZ0z23o2kIS2zxx",
      "type": "text",
      "x": 1522.2698822021484,
      "y": 715.8333333333334,
      "width": 407.55975341796875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
