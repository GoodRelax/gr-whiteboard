      "index": "c23b",
      "roundness": null,
      "seed": 1383615527,
      "version": 3,
      "versionNonce": 753078153,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794547690242,
      "link": null,
      "locked": false,
      "text": "Skip the example, let's just do it with my stuff.\nPros and cons I've done in my head 100 times\nand it always ends 50/50, so the force one.\nToward Tuneslot: hate the reorgs, guitar guy\nactually likes it, the \"what if\" thing.\nHolding me back: 9 months of money, Jess,\nkids plan, and... 1 real customer in 8 months.\nNot sure how you \"weigh\" these tho?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Skip the example, let's just do it with my stuff.\nPros and cons I've done in my head 100 times\nand it always ends 50/50, so the force one.\nToward Tuneslot: hate the reorgs, guitar guy\nactually likes it, the \"what if\" thing.\nHolding me back: 9 months of money, Jess,\nkids plan, and... 1 real customer in 8 months.\nNot sure how you \"weigh\" these tho?",
      "autoResize": true,
      "lineHeight": 1.25
    },
