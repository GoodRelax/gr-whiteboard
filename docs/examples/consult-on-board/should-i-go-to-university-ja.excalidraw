    {
      "id": "V4bT0CJ3RjeC8xIo-Cgvv",
      "type": "text",
      "x": 1100,
      "y": 1682,
      "width": 380.15997314453125,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
