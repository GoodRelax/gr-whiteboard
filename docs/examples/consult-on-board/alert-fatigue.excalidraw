    },
    {
      "id": "ff-del-words",
      "type": "text",
      "x": 1900,
      "y": 1265,
      "width": 638.7596435546875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1rQ",
      "roundness": null,
      "seed": 2083923936,
      "version": 3,
      "versionNonce": 2037594080,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794253207434,
      "link": null,
      "locked": false,
      "customData": {
        "grwbKind": "claudeItem"
      },
      "text": "1. nobody owns an alert\n2. whoever wrote the postmortem adds it, then they move teams\n3. adding one is free\n4. if you delete it and something breaks it's your name on it\n5. nobody wanted to be the one who picked the wrong number\n6. manager reports \"number of postmortem actions closed\"\n    add alert = closed",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. nobody owns an alert\n2. whoever wrote the postmortem adds it, then they move teams\n3. adding one is free\n4. if you delete it and something breaks it's your name on it\n5. nobody wanted to be the one who picked the wrong number\n6. manager reports \"number of postmortem actions closed\"\n    add alert = closed",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "P__5-PQjxHC-dmX0ur0aO",
      "type": "text",
      "x": -920,
      "y": 3535,
      "width": 410.29974365234375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1rR",
      "roundness": null,
      "seed": 2046901216,
      "version": 3,
      "versionNonce": 1110360032,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794253213734,
      "link": null,
      "locked": false,
      "customData": {
        "grwbKind": "answer"
      },
      "text": "That rule is Lv3 Induction, and you built\nit yourself. Two nights make it a good\nguess, not proof. Try it on past incidents\nwhen you've slept.\n\nNow deleting. I listed what you told me\non the right, 1 to 6, your words.\n\nThey aren't equal. Some are causes and\nsome are results of those causes.\n\nIf only ONE of the six could change,\nwhich one would move the most others?\nAnd which others would it move?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "That rule is Lv3 Induction, and you built\nit yourself. Two nights make it a good\nguess, not proof. Try it on past incidents\nwhen you've slept.\n\nNow deleting. I listed what you told me\non the right, 1 to 6, your words.\n\nThey aren't equal. Some are causes and\nsome are results of those causes.\n\nIf only ONE of the six could change,\nwhich one would move the most others?\nAnd which others would it move?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Zu6L943cu_FZ-Z2uVUWBq",
      "type": "text",
      "x": -917.8068186442058,
