      "seed": 840790560,
      "version": 3,
      "versionNonce": 886818784,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794252895089,
      "link": null,
      "locked": false,
      "text": "ok im on the board.\nboxes and arrows is fine but I heard about something\ncalled the Four Forms of Thinking. no idea how it works.\ncan you use that on this? the mute/add loop\nand the thing where nothing watches 'jobs finishing'",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ok im on the board.\nboxes and arrows is fine but I heard about something\ncalled the Four Forms of Thinking. no idea how it works.\ncan you use that on this? the mute/add loop\nand the thing where nothing watches 'jobs finishing'",
      "autoResize": true,
      "lineHeight": 1.25
    },
