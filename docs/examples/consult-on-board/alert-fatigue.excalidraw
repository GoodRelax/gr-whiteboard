      "type": "text",
      "x": 1900,
      "y": 1220,
      "width": 438.71966552734375,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
