      "version": 3,
      "versionNonce": 1764062752,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794253029349,
      "link": null,
      "locked": false,
      "customData": {
        "grwbKind": "answer"
      },
      "text": "Three kinds, and they hold: wake me,\nchore for daytime, weather. I wrote them\nin on the right.\n\n\"2 things in 1 name\" is your find.\n\nNow Lv2 Compare, the Analogy move.\nRetries and the queue look alike:\n  retries: weather UNTIL they run out,\n           then wake me.\n  queue:   weather UNTIL ______,\n           then wake me.\n\nWhat goes in the blank?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Three kinds, and they hold: wake me,\nchore for daytime, weather. I wrote them\nin on the right.\n\n\"2 things in 1 name\" is your find.\n\nNow Lv2 Compare, the Analogy move.\nRetries and the queue look alike:\n  retries: weather UNTIL they run out,\n           then wake me.\n  queue:   weather UNTIL ______,\n           then wake me.\n\nWhat goes in the blank?",
      "autoResize": true,
      "lineHeight": 1.25
    },
