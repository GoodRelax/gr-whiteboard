      "versionNonce": 224978464,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794253172886,
      "link": null,
      "locked": false,
      "text": "work going in. sunday nothing goes in, nothing comes out\n287 night jobs kept going in, nothing came out\nso its in > 0 and out = 0 for a while. thats the page\nthe hum i guess. thats like 1 alert instead of 40\nok now the deleting thing. thats the one that'll kill this",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "work going in. sunday nothing goes in, nothing comes out\n287 night jobs kept going in, nothing came out\nso its in > 0 and out = 0 for a while. thats the page\nthe hum i guess. thats like 1 alert instead of 40\nok now the deleting thing. thats the one that'll kill this",
      "autoResize": true,
      "lineHeight": 1.25
    },
