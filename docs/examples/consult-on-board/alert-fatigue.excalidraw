      "locked": false,
      "customData": {
        "grwbKind": "claudeItem"
      },
      "text": "Who deletes alerts: what you told me",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Who deletes alerts: what you told me",
